# Vosk models (large language models)
vosk-server/models/
vosk-server/*.tar.gz
vosk-server/*.zip

# Piper TTS models
piper-tts/models/
piper-tts/*.tar.gz
piper-tts/*.onnx

# OpenSIPS logs and runtime files
opensips-ai-voice-connector/logs/
*.pid
*.sock

# Test artifacts
test_results/
test_audio/
test_output/

# Documentation build artifacts
docs/_build/
docs/.doctrees/
site/

# Backup files
*.bak
*.backup
*.orig
*~

